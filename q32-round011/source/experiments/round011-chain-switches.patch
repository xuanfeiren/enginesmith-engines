+def _nxt_pf(l, pid, wqkv, wo, wgu, HT, NQL, SL, SLO, hw, qi, PF, PFO, PFN, KVS, qbuf, ring):
+    """the next layer's prefetches (QKV, PFO o_proj, PFN gate/up slabs), issued after (or, PFE, inside) the down GEMV"""
+    nxt = None
+    if PF > 0 and l + 1 < wqkv.shape[0] and ring is None:   # next layer's QKV slabs stream in during the down all-reduce
+        if KVS:
+            nxt, qi = _qkv_slabs(wqkv[l + 1, pid], HT, NQL, pid, SL, hw, qi)
+        elif qbuf is not None:
+            nxt, qi = _prefetch_into(wqkv[l + 1, pid], HT, SL, qbuf[(l + 1) % len(qbuf)], hw, qi)
+        else:
+            nxt, qi = _prefetch(wqkv[l + 1, pid], HT, SL, PF, hw, qi)
+        if PFO > 0:   # and the next layer's first PFO o_proj slabs (round 004)
+            if OB_[0] > 0:   # round 011 (OB): all of the next layer's o_proj in OB DMAs (one tile), as SO-tile slab views
+                SO_ = SLO if SLO > 0 else SL
+                nsl = HT // SO_
+                ow = nl.ndarray((128, HT * NQL * 128), dtype=wo.dtype, buffer=nl.sbuf)
+                per = HT * NQL * 128 // OB_[0]
+                for j in range(OB_[0]):
+                    _dma(ow[:, j * per:(j + 1) * per], wo[l + 1, pid][:, j * per:(j + 1) * per], qi, hw)
+                    qi += 1
+                po_ = []
+                for i in range(nsl):
+                    po_.append(ow[:, i * SO_ * NQL * 128:(i + 1) * SO_ * NQL * 128])
+            else:
+                po_, qi = _prefetch(wo[l + 1, pid], NQL, SLO if SLO > 0 else SL, PFO, hw, qi)
+            nxt = (nxt, po_)
+            if PFN > 0:   # round 010 (PFN): + the next layer's first PFN gate/up slabs (weights to stream during the
+                # down all-reduce chain, where the Sync queue waits on the read-back)
+                gn_, qi = _prefetch(wgu[l + 1, pid], HT, SL, PFN, hw, qi)
+                nxt = (nxt[0], po_, gn_)
+    return nxt, qi
+
