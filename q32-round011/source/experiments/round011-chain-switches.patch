+def _xchg_add_h2(part, pid, rg, W, hb2, hr2, CCQ=0, RBQ=0, copied=False):
+    """round 011 (H2): no two-core sendrecv: physical core pid writes its own fp32 partial into slot pid of the HBM
+    buffer hb2 [2, 128, n], one all_reduce of both slots over the ranks, both slots read back and added
+    (sum order (sum_r p0_r) + (sum_r p1_r) instead of sum_r (p0_r + p1_r): not bitwise)"""
+    n = part.shape[1]
+    if copied:
+        mine = part
+    else:
+        mine = nl.ndarray((128, n), dtype=nl.float32, buffer=nl.sbuf)
+        nisa.tensor_copy(dst=mine, src=part)
+    _dsw(hb2[pid], mine, CCQ)
+    ncc.all_reduce(srcs=[hb2], dsts=[hr2], op=nl.add, replica_group=rg)
+    s2 = nl.ndarray((128, 2, n), dtype=nl.float32, buffer=nl.sbuf)
+    src = hr2.ap(pattern=[[n, 128], [128 * n, 2], [1, n]], offset=0)
+    if RBQ == 2:
+        nisa.dma_copy(dst=s2, src=src, dge_mode=nisa.dge_mode.none)
+    elif RBQ >= 3:
+        _dq(s2, src, RBQ)
+    else:
+        nisa.dma_copy(dst=s2, src=src)
+    s = nl.ndarray((128, n), dtype=nl.float32, buffer=nl.sbuf)
+    nisa.tensor_tensor(dst=s, data1=s2[:, 0, :], data2=s2[:, 1, :], op=nl.add)
+    return s
